{
  "name": "catacomb-snatch-redux",
  "version": "0.3.5",
  "private": true,
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/gameplay.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint:style": "node scripts/check-style.mjs",
    "rules:sync": "node scripts/sync-rules.mjs",
    "check": "npm run typecheck && npm run lint:style && node scripts/sync-rules.mjs --check && npm test",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "miniplex": "^2.0.0",
    "peerjs": "^1.5.5",
    "pixi.js": "^8.5.0",
    "rbush": "^4.0.1",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@types/rbush": "^4.0.0",
    "@types/yuka": "^0.7.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
